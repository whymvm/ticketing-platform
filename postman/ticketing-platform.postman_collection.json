              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/events",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "events"
                  ]
                },
                "description": "The body is not valid JSON.",
                "body": {
                  "mode": "raw",
                  "raw": "{ \"name\": "
                }
              }
            },
            {
              "name": "Unsupported media type",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('returns 415 Unsupported Media Type', () => pm.response.to.have.status(415));",
                      "pm.test('returns code REQUEST_ERROR', () => pm.expect(pm.response.json().code).to.eql('REQUEST_ERROR'));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "text/plain"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/events",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "events"
                  ]
                },
                "description": "The body is sent as plain text instead of JSON.",
                "body": {
                  "mode": "raw",
                  "raw": "plain text"
                }
              }
            }
          ]
        }
      ]
    }
